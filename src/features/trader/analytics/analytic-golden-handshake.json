  "system": {
    "description": {
      "value": "<p><strong>Passive Protocol</strong>: Your maximum Expense Account capacity permanently increases by an amount equal to your <strong>Proficiency Bonus</strong>.</p><p><strong>Active Exchange (Action, 3 Expense Points)</strong>: You offer an exorbitant settlement or fabricated severance package to one humanoid or synthetic creature within 30 feet. The target must succeed on a <strong>Wisdom saving throw</strong> against your Program Save DC or become <strong>Charmed</strong> by you for <strong>1 hour</strong>. While Charmed, it ignores your companions and accepts forged credentials without scrutiny.</p>"
    },

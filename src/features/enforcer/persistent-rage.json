{
  "_id": "EnfPersistRage01",
  "name": "Persistent Rage",
  "type": "feat",
  "img": "icons/magic/fire/flame-burning-skeleton-red.webp",
  "system": {
    "description": {
      "value": "<p>Beginning at 15th level, your rage is so relentless that it ends early only if you fall <strong>Unconscious</strong> or don <strong>Heavy Armor</strong>. It lasts for the full <strong>10 minutes</strong> without requiring round-by-round extension.</p><p>In addition, once per <strong>Long Rest</strong>, when you roll Initiative and have no uses of Rage remaining, you immediately <strong>regain all expended uses of Rage</strong>.</p>"
    },

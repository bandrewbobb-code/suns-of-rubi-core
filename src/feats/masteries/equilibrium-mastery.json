  "name": "Equilibrium Mastery",
  "type": "feat",
  "img": "icons/skills/melee/weapons-crossed-swords-yellow.webp",
  "system": {
    "description": {
      "value": "<p><strong>Prerequisite:</strong> Level 4</p>\n<ul>\n  <li><strong>Ability Score Increase:</strong> Increase your Dexterity or Wisdom score by 1, to a maximum of 20.</li>\n  <li><strong>Fluid Riposte:</strong> When a creature misses you with a weapon attack, you can use your Reaction to make an unarmed strike or weapon attack against that creature.</li>\n  <li><strong>Deflect:</strong> When a creature hits you with a weapon attack, you can use your Reaction to impose a penalty to the attack roll equal to your Proficiency Bonus, potentially causing the attack to miss.</li>\n  <li><strong>Nimble Recovery:</strong> If you are disarmed, you can use your Reaction to immediately catch the weapon.</li>\n</ul>",
      "chat": ""
    },

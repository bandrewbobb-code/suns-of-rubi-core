  "name": "Shielding Mastery",
  "type": "feat",
  "img": "icons/skills/melee/weapons-crossed-swords-yellow.webp",
  "system": {
    "description": {
      "value": "<p><strong>Prerequisite:</strong> Level 4</p>\n<ul>\n  <li><strong>Ability Score Increase:</strong> Increase your Strength or Constitution score by 1, to a maximum of 20.</li>\n  <li><strong>Shield Bash:</strong> If you take the Attack action on your turn and hit a creature with a weapon attack, you can use a Bonus Action to shove that creature within 5 feet of you with your shield.</li>\n  <li><strong>Phalanx Wall:</strong> If you aren’t incapacitated, you and allies within 5 feet of you can add your shield’s AC bonus to any Dexterity saving throw made against a nanoprogram or harmful area effect.</li>\n</ul>",

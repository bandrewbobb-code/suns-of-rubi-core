  "name": "Dueling Mastery",
  "type": "feat",
  "img": "icons/skills/melee/weapons-crossed-swords-yellow.webp",
  "system": {
    "description": {
      "value": "<p><strong>Prerequisite:</strong> Level 4</p>\n<ul>\n  <li><strong>Ability Score Increase:</strong> Increase your Strength or Dexterity score by 1, to a maximum of 20.</li>\n  <li><strong>Flawless Parry:</strong> When a creature hits you with a melee attack, you can use your Reaction to add your Proficiency Bonus to your AC for that attack, potentially causing the attack to miss you.</li>\n  <li><strong>Precision Strike:</strong> Once per turn, when you hit a target with a melee weapon attack that had Advantage, you can add 1d8 to the weapon’s damage roll.</li>\n</ul>",
      "chat": ""
    },
